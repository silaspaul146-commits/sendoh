SENDOH_ENV=development
DATABASE_URL=postgresql+psycopg://sendoh:sendoh@localhost:5432/sendoh
PUBLIC_WEB_URL=http://localhost:3000
OTP_PROVIDER=local
# CORS_ORIGINS=http://localhost:3000
# ALLOWED_HOSTS=localhost,127.0.0.1

# Staging-only alternative until real SMS is connected:
# SENDOH_ENV=staging
# DATABASE_URL=postgresql+psycopg://...Neon connection string...
# PUBLIC_WEB_URL=https://sendoh.vercel.app
# CORS_ORIGINS=https://sendoh.vercel.app
# ALLOWED_HOSTS=sendoh.onrender.com
# OTP_PROVIDER=log
# ALLOW_STAGING_LOG_OTP=1

# Infobip SMS (required when OTP_PROVIDER=infobip):
# INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
# INFOBIP_API_KEY=replace-me
# INFOBIP_SENDER=ServiceSMS
